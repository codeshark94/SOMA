<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.soma.reactive-l0</string>
  <key>ProgramArguments</key>
  <array>
    <string>@SOMA_ROOT@/scripts/soma-reactive-live.zsh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SOMA_ROOT</key>
    <string>@SOMA_ROOT@</string>
    <key>SOMA_APP_ROOT</key>
    <string>@SOMA_APP_ROOT@</string>
    <key>SOMA_RUNTIME_ROOT</key>
    <string>@SOMA_ROOT@/artifacts/subconscious/runtime</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>/dev/null</string>
</dict>
</plist>
